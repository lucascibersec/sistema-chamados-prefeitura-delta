# Copie para ".env" e preencha na VPS. Nunca commitar o .env real.

# Caminho do arquivo de credenciais da Service Account do projeto Firebase
# "sistema-chamados-c3e61" (Console do Firebase > Configurações do projeto >
# Contas de serviço > Gerar nova chave privada). Nunca commitar esse JSON.
FIREBASE_CREDENTIALS_FILE=sistema-chamados-firebase-adminsdk.json

# Origem (domínio) do site que pode chamar esta API. Em produção, coloque o
# domínio real (ex: https://chamados.suaprefeitura.gov.br) em vez de "*".
ALLOWED_ORIGIN=*

# Porta em que o servidor Flask escuta.
PORT=5001
